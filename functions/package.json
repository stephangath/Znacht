{
  "name": "znacht-functions",
  "private": true,
  "description": "Cloud Functions und Planungslogik für Znacht",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --selectProjects unit",
    "test:rules": "jest --selectProjects rules --runInBand"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "firebase": "^12.19.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9"
  }
}
